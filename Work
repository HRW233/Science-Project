<!DOCTYPE html>
<html>
<head>
    <title>Academic Resource Portal</title>
    <style>
        body { margin: 0; font-family: sans-serif; background: #121212; color: #eee; text-align: center; }
        .header { background: #1f1f1f; padding: 20px; border-bottom: 2px solid #333; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 15px; padding: 20px; max-width: 800px; margin: auto; }
        .card { background: #252525; padding: 15px; border-radius: 10px; cursor: pointer; border: 1px solid #444; transition: 0.2s; }
        .card:hover { background: #333; transform: scale(1.05); border-color: #00ff41; }
        #game-container { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #000; z-index: 100; }
        iframe { width: 100%; height: 100%; border: none; }
        .back-btn { position: absolute; top: 10px; left: 10px; padding: 10px; background: #ff4444; color: white; border: none; cursor: pointer; border-radius: 5px; z-index: 101; }
    </style>
</head>
<body>

<div class="header">
    <h1>Project Files: 2026</h1>
    <p>Select a simulation to begin</p>
</div>

<div class="grid">
    <!-- These links use known GitHub mirrors that bypass most filters -->
    <div class="card" onclick="loadGame('https://crp-72.github.io')">🏈 Physics: Retro</div>
    <div class="card" onclick="loadGame('https://3kh0-assets.pages.dev')">🌀 Geometry: Slope</div>
    <div class="card" onclick="loadGame('https://3kh0-assets.pages.dev')">🏗️ Architecture: 1v1</div>
    <div class="card" onclick="loadGame('https://3kh0-assets.pages.dev')">🧬 Biology: BitLife</div>
    <div class="card" onclick="loadGame('https://3kh0-assets.pages.dev')">🏃 Velocity: Subway</div>
    <div class="card" onclick="loadGame('https://3kh0-assets.pages.dev')">🕳️ Logic: OvO</div>
    <div class="card" onclick="loadGame('https://3kh0-assets.pages.dev')">⛏️ Mining: Classic</div>
    <div class="card" onclick="loadGame('https://3kh0-assets.pages.dev')">🍪 Econ: Clicker</div>
</div>

<div id="game-container">
    <button class="back-btn" onclick="closeGame()">Close Project</button>
    <iframe id="game-frame" src=""></iframe>
</div>

<script>
    function loadGame(url) {
        document.getElementById('game-frame').src = url;
        document.getElementById('game-container').style.display = 'block';
    }
    function closeGame() {
        document.getElementById('game-container').style.display = 'none';
        document.getElementById('game-frame').src = '';
    }
</script>

</body>
</html>
